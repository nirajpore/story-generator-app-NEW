# Gemini server-side API key (never expose in browser code)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: change default Gemini model from one place
GEMINI_MODEL=gemini-1.5-flash

# DeepSeek server-side API key (alternative to Gemini)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: change default DeepSeek model
DEEPSEEK_MODEL=deepseek-chat

# Optional local default shown in client config
NEXT_PUBLIC_DEFAULT_AI_MODEL=gemini-1.5-flash
